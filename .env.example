# =============================================
# EventPix Intelligence — Variables de Entorno
# =============================================
# Copiá este archivo como .env y completá los valores

# --- Meta / Instagram Graph API ---
# Obtenelos desde https://developers.facebook.com/apps/2345235469580053
VITE_META_APP_ID=2345235469580053
VITE_META_APP_SECRET=your_app_secret_here
VITE_META_REDIRECT_URI=http://localhost:5173/auth/meta/callback

# --- Supabase (persistencia de datos) ---
VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# --- OpenAI (análisis real de Reels & síntesis) ---
# Modelo "bring your own key": cada negocio conecta la suya desde
# Conectar APIs > OpenAI en la UI. Esta variable de Vite es solo para
# desarrollo local; en producción la clave vive en el estado de conexión
# del negocio, no en el bundle del cliente.
VITE_OPENAI_API_KEY=your_openai_api_key

# --- Anthropic Claude (redacción creativa de guiones & análisis profundo) ---
# Obtenela desde https://console.anthropic.com/settings/keys
VITE_ANTHROPIC_API_KEY=sk-ant-api03-...

# --- Google Gemini (alta velocidad & redacción natural para Reels) ---
# Obtenela gratis desde https://aistudio.google.com/app/apikey
VITE_GEMINI_API_KEY=AIzaSy...

# ================================================================
# Variables de SERVIDOR (Vercel serverless functions bajo /api).
# Nunca se exponen al cliente (no llevan prefijo VITE_). Configuralas en
# Vercel > Settings > Environment Variables, no en un .env que se commitee.
# ================================================================

# Motor 2: Generador de Reels Hablados (/api/reels/generate-spoken-script).
# Opcional: si el negocio no tiene su propia clave conectada en "Conectar
# APIs", el endpoint puede usar esta clave de plataforma como fallback.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Análisis de Perfiles Públicos (/api/meta-business-discovery).
# Cuenta de Instagram Business/Creator del ADMIN de la plataforma, cargada UNA
# SOLA VEZ acá. Con esto, ningún negocio/cliente nuevo necesita conectar su
# propia cuenta de Meta solo para analizar competidores o importar perfiles
# públicos al Canvas — se usa esta como fallback automático.
# Access Token: Meta for Developers > tu app > Graph API Explorer (o el token
#   de larga duración de la página conectada a esta cuenta de Instagram).
# IG Account ID: el "Instagram Account ID" de ESA cuenta (Business/Creator,
#   vinculada a una página de Facebook) — es el mismo dato que pedía antes el
#   formulario de "Conectar APIs > Instagram", pero puesto acá una sola vez.
META_PLATFORM_ACCESS_TOKEN=
META_PLATFORM_IG_ACCOUNT_ID=
