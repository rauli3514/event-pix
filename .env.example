VITE_SUPABASE_URL=your_supabase_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# ================================================================
# Variables de SERVIDOR (Vercel serverless functions bajo /api).
# Nunca se exponen al cliente (no llevan prefijo VITE_). Configuralas en
# Vercel > Settings > Environment Variables, no en un .env que se commitee.
# ================================================================

# Motor 1: Analizador de Perfiles de Instagram (/api/instagram-scrape,
# /api/profile-analysis). Requiere una cuenta de Apify (u otro proveedor de
# scraping de perfiles publicos) — no se piden contrasenas de Instagram.
SCRAPER_API_KEY=
APIFY_INSTAGRAM_ACTOR_ID=apify~instagram-profile-scraper

# Motor 2: Generador de Reels Hablados (/api/reels/generate-spoken-script) y
# transcripcion de audio (/api/instagram-transcribe). Se usa Claude si esta
# configurada; si no, se cae a OpenAI GPT-4o.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=