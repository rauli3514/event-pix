# ================================================================
# social-analytics-api - variables de entorno
# Copia este archivo a ".env" y completa lo que vayas a usar.
# Ningun endpoint pide contrasenas de Instagram/TikTok: todo se
# obtiene de perfiles publicos via APIs/servicios de terceros.
# ================================================================

PORT=4000

# --- Anthropic (resumen ejecutivo con IA) ---
# Requerido para que /api/profiles/analyze incluya executive_summary.
# Si no esta seteada, el reporte se genera igual pero con un resumen
# generado localmente (sin IA) en vez de fallar.
ANTHROPIC_API_KEY=

# --- Proveedor de datos de Instagram ---
# mock  -> datos de ejemplo, sin llamadas externas (default, sirve para probar la API ya mismo)
# meta  -> Meta Graph API "Business Discovery" (oficial, requiere que TU cuenta sea Business/Creator)
# apify -> Apify (actor de terceros, de pago, requiere token)
INSTAGRAM_PROVIDER=mock

# Requeridos solo si INSTAGRAM_PROVIDER=meta
# Ver: https://developers.facebook.com/docs/instagram-platform/instagram-graph-api/business-discovery
META_ACCESS_TOKEN=
META_IG_BUSINESS_ID=
META_GRAPH_VERSION=v21.0

# Requeridos solo si INSTAGRAM_PROVIDER=apify (o TIKTOK_PROVIDER=apify)
APIFY_TOKEN=
APIFY_INSTAGRAM_ACTOR_ID=apify~instagram-profile-scraper
APIFY_TIKTOK_ACTOR_ID=clockworks~tiktok-scraper

# --- Proveedor de datos de TikTok ---
# mock  -> datos de ejemplo, sin llamadas externas (default)
# apify -> Apify (actor de terceros, de pago, requiere token)
TIKTOK_PROVIDER=mock
